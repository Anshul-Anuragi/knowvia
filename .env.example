# ==============================================================
# Knowvia AI - Root Environment Example (for Docker Compose)
# Duplicate this file to '.env' before running `docker-compose up`.
# ==============================================================

# Backend Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@db:5432/knowvia

# Security & JWT
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters

# AI & Vector Database Keys
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=knowvia-rag
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=your_tavily_api_key_here

# Redis Cache URL
REDIS_URL=redis://redis:6379

# Frontend Public API URL (accessible by user browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
